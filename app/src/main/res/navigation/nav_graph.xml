<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/roleSelectFragment">

    <!-- Al entrar se borra de la pila. -->
    <fragment
        android:id="@+id/roleSelectFragment"
        android:name="com.equipo2.vinilos.ui.role.RoleSelectFragment">
        <action
            android:id="@+id/action_roleSelect_to_albums"
            app:destination="@id/albumListFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/albumListFragment"
        android:name="com.equipo2.vinilos.ui.common.EmptySectionFragment"
        android:label="@string/album_list_title" />

    <fragment
        android:id="@+id/artistsFragment"
        android:name="com.equipo2.vinilos.ui.common.EmptySectionFragment"
        android:label="@string/artist_list_title" />

    <fragment
        android:id="@+id/collectorsFragment"
        android:name="com.equipo2.vinilos.ui.common.EmptySectionFragment"
        android:label="@string/collector_list_title" />
</navigation>
