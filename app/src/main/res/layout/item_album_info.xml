<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de la tarjeta de datos del álbum: ícono, etiqueta y valor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/infoIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        app:tint="@color/md_on_surface_variant"
        tools:src="@drawable/ic_calendar_today" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/infoLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Vinilos.LabelMedium"
            android:textColor="@color/md_on_surface_variant"
            tools:text="Fecha de lanzamiento" />

        <TextView
            android:id="@+id/infoValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Vinilos.BodyLarge"
            android:textColor="@color/md_on_surface"
            tools:text="1 de agosto de 1984" />
    </LinearLayout>
</LinearLayout>
