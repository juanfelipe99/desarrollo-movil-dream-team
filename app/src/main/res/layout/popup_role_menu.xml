<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/role_menu_width"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/menuHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:textAllCaps="true"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/md_on_surface_variant"
            tools:text="MODO ACTUAL: VISITANTE" />

        <LinearLayout
            android:id="@+id/optionVisitor"
            style="@style/Widget.Vinilos.MenuRow"
            android:minHeight="56dp">

            <ImageView
                style="@style/Widget.Vinilos.MenuRow.Icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person" />

            <LinearLayout style="@style/Widget.Vinilos.MenuRow.Texts">

                <TextView
                    style="@style/Widget.Vinilos.MenuRow.Title"
                    android:text="@string/role_visitor" />

                <TextView
                    style="@style/Widget.Vinilos.MenuRow.Description"
                    android:text="@string/role_visitor_desc" />
            </LinearLayout>

            <ImageView
                android:id="@+id/checkVisitor"
                style="@style/Widget.Vinilos.MenuRow.Check"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optionCollector"
            style="@style/Widget.Vinilos.MenuRow"
            android:minHeight="56dp">

            <ImageView
                style="@style/Widget.Vinilos.MenuRow.Icon"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_album" />

            <LinearLayout style="@style/Widget.Vinilos.MenuRow.Texts">

                <TextView
                    style="@style/Widget.Vinilos.MenuRow.Title"
                    android:text="@string/role_collector" />

                <TextView
                    style="@style/Widget.Vinilos.MenuRow.Description"
                    android:text="@string/role_collector_desc" />
            </LinearLayout>

            <ImageView
                android:id="@+id/checkCollector"
                style="@style/Widget.Vinilos.MenuRow.Check"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <View style="@style/Widget.Vinilos.MenuDivider" />

        <!-- Claro, del sistema u oscuro, con el elegido marcado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                style="@style/Widget.Vinilos.MenuRow.Title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:text="@string/theme_mode_header" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/themeModeGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeLight"
                    style="@style/Widget.Vinilos.ThemeModeButton"
                    android:contentDescription="@string/cd_theme_mode_light"
                    app:icon="@drawable/ic_light_mode" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeSystem"
                    style="@style/Widget.Vinilos.ThemeModeButton"
                    android:contentDescription="@string/cd_theme_mode_system"
                    app:icon="@drawable/ic_contrast" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/themeDark"
                    style="@style/Widget.Vinilos.ThemeModeButton"
                    android:contentDescription="@string/cd_theme_mode_dark"
                    app:icon="@drawable/ic_dark_mode" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <View style="@style/Widget.Vinilos.MenuDivider" />

        <TextView
            android:id="@+id/optionRoleSelect"
            style="@style/Widget.Vinilos.MenuRow"
            android:drawablePadding="12dp"
            android:minHeight="48dp"
            android:text="@string/role_menu_role_select"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/md_on_surface"
            app:drawableStartCompat="@drawable/ic_home"
            app:drawableTint="@color/md_on_surface_variant" />
    </LinearLayout>
</ScrollView>
