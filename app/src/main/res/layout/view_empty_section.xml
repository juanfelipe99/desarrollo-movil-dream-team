<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta punteada de una sección vacía, por ejemplo un álbum sin tracks. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_empty_section"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/emptySectionIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        app:tint="@color/md_on_surface_variant"
        tools:src="@drawable/ic_music_note" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/emptySectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Vinilos.LabelLarge"
            android:textColor="@color/md_on_surface"
            tools:text="Este álbum aún no tiene tracks" />

        <TextView
            android:id="@+id/emptySectionBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.Vinilos.BodyMedium"
            android:textColor="@color/md_on_surface_variant"
            tools:text="Las canciones aparecerán aquí cuando se registren." />
    </LinearLayout>
</LinearLayout>
