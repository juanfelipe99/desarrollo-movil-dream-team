<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Botón «+» para crear un álbum, solo para el coleccionista (HU07) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/createAlbumButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/cd_create_album"
        android:visibility="gone"
        app:backgroundTint="@color/md_primary"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/md_on_primary" />
</FrameLayout>
