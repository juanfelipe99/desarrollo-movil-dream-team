<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:layout_width="@dimen/role_select_logo"
        android:layout_height="@dimen/role_select_logo"
        android:contentDescription="@string/cd_logo"
        android:src="@drawable/ic_vinilos_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceDisplaySmall" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:maxWidth="300dp"
        android:text="@string/role_select_tagline"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/md_on_surface_variant" />
</LinearLayout>
