<?xml version="1.0" encoding="utf-8"?>
<!-- Chip de rol de la barra superior: el fondo mide 32 dp y la vista 48 dp, que es el área táctil. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/touch_target"
    android:background="@drawable/bg_role_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="6dp">

    <ImageView
        android:id="@+id/roleChipIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/bg_circle_primary_container"
        android:importantForAccessibility="no"
        android:padding="4dp"
        app:tint="@color/md_on_primary_container"
        tools:src="@drawable/ic_person" />

    <TextView
        android:id="@+id/roleChipText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@color/md_on_surface"
        tools:text="@string/role_visitor" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_expand_more"
        app:tint="@color/md_on_surface_variant" />
</LinearLayout>
